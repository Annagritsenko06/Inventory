@model SearchResultViewModel

<h2>Результаты поиска: "@Model.Query"</h2>

<h3>Инвентарь</h3>
<table id="inventoryTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Название</th>
            <th>Категория</th>
            <th>Описание</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inv in Model.Inventories)
        {
            <tr>
                <td>
                    <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id">
                        @inv.Name
                    </a>
                </td>
                <td>@inv.Category</td>
                <td>@inv.Description</td>
            </tr>
        }
    </tbody>
</table>

<h3>Элементы</h3>
<table id="itemsTable" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Custom ID</th>
            <th>Значения</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    <a asp-controller="Inventories" asp-action="Details" asp-route-id="@item.Id">
                        @item.CustomId
                    </a>
                </td>
                <td>@item.ValuesJson</td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script>
        $(document).ready(function () {
            $('#inventoryTable').DataTable();
            $('#itemsTable').DataTable();
        });
    </script>
}
