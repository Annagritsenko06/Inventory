@model SearchResultViewModel

<div class="container mt-4">
    <h2 class="fw-bold mb-4">🔍 Результаты поиска: "@Model.Query"</h2>

    <!-- Вкладки -->
    <ul class="nav nav-tabs mb-3" id="searchTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="inventories-tab" data-bs-toggle="tab" data-bs-target="#inventories" type="button" role="tab" aria-controls="inventories" aria-selected="true">
                📦 Инвентарь (@Model.Inventories.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="items-tab" data-bs-toggle="tab" data-bs-target="#items" type="button" role="tab" aria-controls="items" aria-selected="false">
                🧩 Элементы (@Model.Items.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="searchTabsContent">
        <!-- ======= Вкладка: Инвентари ======= -->
        <div class="tab-pane fade show active" id="inventories" role="tabpanel" aria-labelledby="inventories-tab">
            @if (!Model.Inventories.Any())
            {
                <p class="text-muted">Нет найденных инвентарей.</p>
            }
            else
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Название</th>
                                <th>Категория</th>
                                <th>Описание</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Inventories)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none fw-bold">
                                            @inv.Name
                                        </a>
                                    </td>
                                    <td>@inv.Category</td>
                                    <td>@inv.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ======= Вкладка: Элементы ======= -->
        <div class="tab-pane fade" id="items" role="tabpanel" aria-labelledby="items-tab">
            @if (!Model.Items.Any())
            {
                <p class="text-muted">Нет найденных элементов.</p>
            }
            else
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Custom ID</th>
                                <th>Значения</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-bold">
                                            @item.CustomId
                                        </a>
                                    </td>
                                    <td>@item.ValuesJson</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

