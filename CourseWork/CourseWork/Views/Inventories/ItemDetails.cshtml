@model CourseWork.Models.InventoryItemViewModel
@{
    bool isEdit = (bool)(ViewData["IsEdit"] ?? false);
}

<h2>@(isEdit ? "✏️ Редактирование элемента" : "👁 Просмотр элемента")</h2>

<form asp-action="SaveItem" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label fw-bold">Custom ID</label>
        <input type="text" name="CustomId" value="@Model.CustomId"
               class="form-control" @(isEdit ? "" : "readonly") />
    </div>

    <h5>Поля</h5>
    <hr />

    @for (int i = 0; i < Model.FieldValues.Count; i++)
    {
        <div class="mb-3">
            <label class="form-label fw-bold">Поле @(i + 1)</label>
            <input type="text" name="FieldValues[@(i)]" value="@Model.FieldValues[i]"
                   class="form-control" @(isEdit ? "" : "readonly") />
        </div>
    }


    @if (isEdit)
    {
        <button type="submit" class="btn btn-success mt-3">💾 Сохранить изменения</button>
    }
    else
    {
        <a asp-action="ItemDetails" asp-route-id="@Model.Id" asp-route-isEdit="true"
           class="btn btn-outline-primary mt-3">✏️ Редактировать</a>
    }
</form>
