@using Microsoft.AspNetCore.Mvc.Localization
@model CourseWork.Models.InventoryItemViewModel
@inject IViewLocalizer L

@{
    bool isEdit = (bool)(ViewData["IsEdit"] ?? false);
}

<h2>@(isEdit ? "✏️ " + @L["Edit_item"].Value  : "👁 " + @L["View_item"].Value)</h2>

<form asp-action="SaveItem" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label fw-bold">Custom ID</label>
        <input type="text" name="CustomId" value="@Model.CustomId"
               class="form-control" @(isEdit ? "" : "readonly") />
    </div>

    <h5>@L["Fields"]</h5>
    <hr />

    @for (int i = 0; i < Model.FieldValues.Count; i++)
    {
        <div class="mb-3">
            <label class="form-label fw-bold">@L["Field"] @(i + 1)</label>
            <input type="text" name="FieldValues[@(i)]" value="@Model.FieldValues[i]"
                   class="form-control" @(isEdit ? "" : "readonly") />
        </div>
    }

    @if (isEdit)
    {
        <button type="submit" class="btn btn-success mt-3">💾 @L["Save_changes"]</button>
    }
   
</form>
