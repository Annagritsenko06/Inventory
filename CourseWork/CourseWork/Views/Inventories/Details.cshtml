@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model CourseWork.Models.InventoryWithItemsViewModel
@{
    ViewData["Title"] = Model.Inventory.Name;
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    var isOwnerOrAdmin = User.Identity?.IsAuthenticated == true &&
        (User.IsInRole("Admin") ||
         Model.Inventory.OwnerId.ToString() ==
         User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);

    var categories = new[] { L["Equipment"].Value, L["Furniture"].Value, L["Book"].Value, L["Other"].Value };
    var fieldsVM = Model.Fields ?? new CourseWork.Models.InventoryFieldsVM();
    var fieldsList = fieldsVM.Fields ?? new List<CourseWork.Models.InventoryFieldCreateVM>();

}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold">@Model.Inventory.Name</h2>
        <p class="text-muted mb-0">@Model.Inventory.Description</p>
    </div>
    <div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Inventories" asp-action="AddItem"
               asp-route-inventoryId="@Model.Inventory.Id"
               class="btn btn-outline-secondary">
                ➕ @L["Add_item"]
            </a>
        }
    </div>
</div>

<!-- === Вкладки Bootstrap === -->
<ul class="nav nav-tabs" id="inventoryTabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#items">📦 Элементы</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#discussion">💬 Обсуждение</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#customid">🧩 Custom ID</button></li>
    @if (isOwnerOrAdmin)
    {
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats">📊 Статистика</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#edit">⚙️ Общие настройки</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#access">🔐 Доступ</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tags">🏷️ Теги</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#elements">🧱 Элементы (поля)</button></li>
    }
</ul>


<div class="tab-content mt-3">
    <div class="tab-pane fade show active" id="items">
            <form asp-action="EditSelected" method="post" id="itemsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />

            <!-- ====== Тулбар ====== -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <button type="submit" name="action" value="delete" class="btn btn-outline-danger btn-sm">
                        🗑 @L["Delete_selected"]
                    </button>
                    
                    <button type="submit" name="action" value="view" class="btn btn-sm btn-outline-secondary">
                        👁  @L["View_selected"]
                    </button>
                    <button type="submit" name="action" value="edit" class="btn btn-sm btn-outline-primary">
                        ✏️  @L["Edit_selected"]
                    </button>

                </div>
                <div class="text-muted small">@L["Select_items_for_actions"]</div>
            </div>

            <!-- ====== Таблица элементов ====== -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                            @foreach (var field in Model.Inventory.Fields.Where(f => f.ShowInTable).OrderBy(f => f.Order))
                            {
                                <th>@field.Name</th>
                            }
                            <th>@L["Likes"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            Guid.TryParse(userIdString, out Guid userId);
                            var allFields = Model.Inventory.Fields.OrderBy(f => f.Order).ToList();
                            var shownFields = allFields.Where(f => f.ShowInTable).ToList();
                        }

                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><input type="checkbox" name="selectedIds" value="@item.Id" /></td>
                        

                                @foreach (var field in shownFields)
                                {
                                    var index = allFields.IndexOf(field);
                                    string value = (index >= 0 && index < item.FieldValues.Count)
                                    ? item.FieldValues[index]
                                    : "-";
                                    <td>@value</td>
                                }

                                <!-- ====== Кнопка лайка ====== -->
                                <td>
                                    <button type="submit"
                                            formaction="@Url.Action("ToggleLike", "Inventories")"
                                            formmethod="post"
                                            name="itemId"
                                            value="@item.Id"
                                            class="btn btn-sm btn-outline-danger">
                                        @(item.Likes.Any(l => l.UserId == userId) ? "❤️" : "🤍") @item.Likes.Count()
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>

    
    <!-- ================= DISCUSSION ================= -->
    <div class="tab-pane fade" id="discussion">
        <div id="messages" class="border rounded p-3 mb-3" style="max-height:300px; overflow:auto;"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <textarea id="msgText" class="form-control mb-2" rows="3" placeholder="@L["Write_message"]"></textarea>
            <button id="sendMsg" class="btn btn-outline-secondary">@L["Send"]</button>
        }
        else
        {
            <div class="alert alert-light">@L["Login_to_participate"]</div>
        }
    </div>

    <!-- ================= CUSTOM ID ================= -->
    <div class="tab-pane fade" id="customid">
        @await Html.PartialAsync("_CustomIdTab", Model)
    </div>

    <!-- ================= STATS ================= -->

    <div class="tab-pane fade" id="stats" role="tabpanel">
        @await Html.PartialAsync("_StatsPartial", Model)
    </div>

    @if (isOwnerOrAdmin)
    {
        <!-- ================= EDIT SETTINGS ================= -->
        <div class="tab-pane fade" id="edit">
            <form asp-action="SaveSettings" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Id" value="@Model.Inventory.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Name"]</label>
                    <input type="text" name="Name" value="@Model.Inventory.Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Description_Markdown"]</label>
                    <textarea name="Description" class="form-control" rows="5">@Model.Inventory.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Category"]</label>
                    <select name="Category" class="form-select">
                        @foreach (var c in categories)
                        {
                            <option value="@c" selected="@(Model.Inventory.Category == c)">@c</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Image"]</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" onchange="previewImage(event)" />
                    <div class="mt-2">
                        @if (!string.IsNullOrEmpty(Model.Inventory.ImageUrl))
                        {
                            <img id="imagePreview" src="@Model.Inventory.ImageUrl" alt="@L["Image"]" class="img-thumbnail" style="max-height:200px;">
                        }
                        else
                        {
                            <img id="imagePreview" class="img-thumbnail d-none" style="max-height:200px;">
                        }
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="IsPublic" value="true" @(Model.Inventory.IsPublic ? "checked" : "") />
                    <input type="hidden" name="IsPublic" value="false" />
                    <label class="form-check-label">@L["Public_allow_all_to_add"]</label>
                </div>

                <button type="submit" class="btn btn-success">💾 @L["Save_changes"]</button>
            </form>
        </div>
        <!-- ========== ACCESS ========== -->
        <div class="tab-pane fade" id="access">
            <h5>@L["Access_settings"]</h5>

            @if (Model.Inventory.IsPublic)
            {
                <div class="alert alert-info">
                    <strong>@L["Public_inventory"]</strong> – @L["Accessible_to_all_users"]
                </div>
            }
            else
            {
                <p>@L["Manage_users_with_access"]</p>

                <div class="card mb-3">
                    <div class="card-body">
                        <form asp-action="AddUserAccess" asp-controller="Inventories" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />

                            <div class="mb-2">
                                <label class="form-label">@L["Username_or_email"]</label>
                                <input type="text" name="searchTerm" class="form-control" value="@Model.SearchTerm" placeholder="@L["Enter_name_or_email"]" />
                            </div>

                            <button type="submit" class="btn btn-primary">@L["Add_user"]</button>
                        </form>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>@L["Users_with_access"]</strong>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Inventory.Id" asp-route-sortOrder="name"
                           class="btn btn-sm btn-outline-secondary @(Model.SortOrder == "name" ? "active" : "")">
                            @L["Sort_by_name"]
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Inventory.Id" asp-route-sortOrder="email"
                           class="btn btn-sm btn-outline-secondary @(Model.SortOrder == "email" ? "active" : "")">
                            @L["Sort_by_email"]
                        </a>
                    </div>
                </div>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>@L["Name"]</th>
                            <th>Email</th>
                            <th style="width: 120px;">@L["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AllowedUsers != null && Model.AllowedUsers.Any())
                        {
                            foreach (var user in Model.AllowedUsers)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <form asp-action="RemoveUserAccess" method="post" class="d-inline">
                                            <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["Remove"]</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-muted text-center">@L["No_users_with_access"]</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ========== TAGS ========== -->
        <div class="tab-pane fade" id="tags">
            <form asp-action="SaveTags" method="post">
                <input type="hidden" name="InventoryId" value="@Model.Inventory.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Tags"]</label>

                    @if (Model.Inventory.Tags != null && Model.Inventory.Tags.Any())
                    {
                        foreach (var tag in Model.Inventory.Tags)
                        {
                            <input type="text" name="Tags" value="@tag.Name" class="form-control mb-1" />
                        }
                    }

                    <input type="text" name="Tags" class="form-control" placeholder="@L["Enter_new_tag"]" />
                </div>

                <button type="submit" class="btn btn-success">💾 @L["Save_tags"]</button>
            </form>
        </div>

        <!-- ========== FIELDS ========== -->
        <div class="tab-pane fade" id="elements">
            @await Html.PartialAsync("_InventoriesFields", new CourseWork.Models.InventoryFieldsVM
   {
       Fields = fieldsList,
       FieldForm = new InventoryFieldCreateVM { InventoryId = Model.Inventory.Id }
   })
        </div>
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script>
        // ======== SignalR discussion ========
        const connection = new signalR.HubConnectionBuilder().withUrl('/discussionHub').build();
        connection.start().then(() => connection.invoke('Join', '@Model.Inventory.Id'));
        connection.on('ReceiveMessage', msg => {
            const html = `<div class="mb-2 p-2 border rounded">
                <strong>${msg.user}</strong>
                <small class="text-muted">${new Date(msg.time).toLocaleString()}</small>
                <div class="mt-1">${renderMarkdown(msg.message)}</div></div>`;
            const container = document.getElementById('messages');
            container.insertAdjacentHTML('beforeend', html);
            container.scrollTop = container.scrollHeight;
        });
        function renderMarkdown(t) {
            return t.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/`(.*?)`/g, '<code>$1</code>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
                    .replace(/\n/g, '<br>');
        }
        document.getElementById('sendMsg')?.addEventListener('click', () => {
            const text = document.getElementById('msgText').value.trim();
            if (text) {
                connection.invoke('SendMessage', '@Model.Inventory.Id', text);
                document.getElementById('msgText').value = '';
            }
        });

        // ======== Image preview ========
        function previewImage(event) {
            const output = document.getElementById('imagePreview');
            output.src = URL.createObjectURL(event.target.files[0]);
            output.classList.remove('d-none');
        }
        
function toggleAll(source) {
    const checkboxes = document.querySelectorAll('input[name="selectedIds"]');
    checkboxes.forEach(cb => cb.checked = source.checked);
}

    </script>
}
