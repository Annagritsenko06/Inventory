@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model CourseWork.Models.InventoryWithItemsViewModel
@{
    ViewData["Title"] = Model.Inventory.Name;
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    var isOwnerOrAdmin = User.Identity?.IsAuthenticated == true &&
        (User.IsInRole("Admin") ||
         Model.Inventory.OwnerId.ToString() ==
         User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);

    var fieldsVM = Model.Fields ?? new CourseWork.Models.InventoryFieldsVM();
    var fieldsList = fieldsVM.Fields ?? new List<CourseWork.Models.InventoryFieldCreateVM>();
    bool canEdit = Model.CanEdit;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold">@Model.Inventory.Name</h2>
        <p class="text-muted mb-0" id="inventoryDescription">@Model.Inventory.Description</p>
    </div>
    <div>
        @if (User.Identity?.IsAuthenticated == true && canEdit)
        {
            <a asp-controller="Inventories" asp-action="AddItem"
               asp-route-inventoryId="@Model.Inventory.Id"
               class="btn btn-outline-secondary">
                ➕ @L["Add_item"]
            </a>
        }
    </div>
</div>

<div class="overflow-auto">
    <ul class="nav nav-tabs flex-nowrap" id="inventoryTabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#items">📦 @L["Items"]</button></li>
        @if(canEdit){
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#discussion">💬 @L["Discussion"]</button></li>
        }
        @if (isOwnerOrAdmin)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#customid">🧩 @L["Custom_ID"]</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats">📊 @L["Statistics"]</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#edit">⚙️ @L["General_settings"]</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#access">🔐 @L["Access"]</button></li>
             <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#elements">🧱 @L["Fields"]</button></li>
        }
    </ul>
</div>




<div class="tab-content mt-3">
    <div class="tab-pane fade show active" id="items">
            <form asp-action="EditSelected" method="post" id="itemsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    @if (canEdit){
                    <button type="submit" name="action" value="delete" class="btn btn-outline-danger btn-sm">
                        🗑 @L["Delete_selected"]
                    </button>
                    }
                    <button type="submit" name="action" value="view" class="btn btn-sm btn-outline-secondary">
                        👁  @L["View_selected"]
                    </button>
                    @if (canEdit)
                    {
                    <button type="submit" name="action" value="edit" class="btn btn-sm btn-outline-primary">
                        ✏️  @L["Edit_selected"]
                    </button>
                    }

                </div>
                <div class="text-muted small">@L["Select_items_for_actions"]</div>
            </div>

          
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                            @foreach (var field in Model.Inventory.Fields.Where(f => f.ShowInTable).OrderBy(f => f.Order))
                            {
                                <th>@field.Name</th>
                            }
                           @if(canEdit){
                            <th>@L["Likes"]</th>
                           }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            Guid.TryParse(userIdString, out Guid userId);
                            var allFields = Model.Inventory.Fields.OrderBy(f => f.Order).ToList();
                            var shownFields = allFields.Where(f => f.ShowInTable).ToList();
                        }

                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><input type="checkbox" name="selectedIds" value="@item.Id" /></td>
                        

                                @foreach (var field in shownFields)
                                {
                                    var index = allFields.IndexOf(field);
                                    string value = (index >= 0 && index < item.FieldValues.Count)
                                    ? item.FieldValues[index]
                                    : "-";
                                    <td>
                                        @if (field.Type == CourseWork.Models.FieldType.ImageLink)
                                        {
                                            if (!string.IsNullOrEmpty(value))
                                            {
                                                <a href="@value" target="_blank">@L["Open"]</a>
                                            }
                                            else
                                            {
                                                @("-")
                                            }
                                        }
                                        else
                                        {
                                            @value
                                        }
                                    </td>
                                }
                                @if (canEdit){
                                <td>
                                    <button type="submit"
                                            formaction="@Url.Action("ToggleLike", "Inventories")"
                                            formmethod="post"
                                            name="itemId"
                                            value="@item.Id"
                                            class="btn btn-sm btn-outline-danger">
                                        @(item.Likes.Any(l => l.UserId == userId) ? "❤️" : "🤍") @item.Likes.Count()
                                    </button>
                                </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>

    @if (canEdit){
 
        <div class="tab-pane fade" id="discussion">
            <div id="messages" class="border rounded p-3 mb-3" style="max-height:300px; overflow:auto;">
                @if (Model.Discussions != null && Model.Discussions.Any())
                {
                    @foreach (var msg in Model.Discussions)
                    {
                        <div class="mb-2 p-2 border rounded">
                            <strong>@msg.User?.UserName</strong>
                            <small class="text-muted">@msg.CreatedAt.ToLocalTime().ToString("g")</small>
                            <div class="mt-1">@msg.Message</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center fst-italic">@L["NoCom"]</div>
                }
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <textarea id="msgText" class="form-control mb-2" rows="3" placeholder="@L["Write_message"]"></textarea>
                <button id="sendMsg" class="btn btn-outline-secondary">@L["Send"]</button>
            }
            else
            {
                <div class="alert alert-light">@L["Login_to_participate"]</div>
            }
        </div>

    }
   
    <div class="tab-pane fade" id="customid">
        @await Html.PartialAsync("_CustomIdTab", Model)
    </div>


    <div class="tab-pane fade" id="stats" role="tabpanel">
        @await Html.PartialAsync("_StatsPartial", Model)
    </div>

    @if (isOwnerOrAdmin)
    {
        <div class="tab-pane fade" id="edit">
            <form asp-controller="Inventories" asp-action="GenerateToken" method="post">
                <input type="hidden" asp-for="Inventory.Id" name="Id"/>

                <div class="modal-header">
                    <button type="submit" class="btn btn-primary">
                        Create token for Inventory
                    </button>
                </div>
            </form>

            @using (Html.BeginForm("EditInv", "Inventories", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.Inventory.Id)

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Name"]</label>
                    <input asp-for="Inventory.Name"  class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Description_Markdown"]</label>
                    <textarea asp-for="Inventory.Description"  class="form-control" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["Category"]</label>
                    <select asp-for="Inventory.Category" class="form-select">
                        @foreach (var c in Enum.GetValues(typeof(CourseWork.Models.Inventories.InventoryCategory)))
                        {
                            <option value="@c" selected="@(Model.Inventory.Category == (CourseWork.Models.Inventories.InventoryCategory)c)">
                                @c
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Inventory.ImageUrl" class="form-label">@L["ImageUrl"]</label>
                    <input asp-for="Inventory.ImageUrl" class="form-control" placeholder="https://..." />
                    @if (!string.IsNullOrEmpty(Model.Inventory.ImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.Inventory.ImageUrl" alt="@L["InventoryImageAlt"]" class="img-thumbnail" style="max-height:150px;" />
                        </div>
                    }
                </div>
               
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="IsPublic" value="true" @(Model.Inventory.IsPublic ? "checked" : "") />
                    <input type="hidden" name="IsPublic" value="false" />
                    <label class="form-check-label">@L["Public_allow_all_to_add"]</label>
                </div>

                <button type="submit" class="btn btn-success">💾 @L["Save_changes"]</button>
            }
        </div>

        <div class="tab-pane fade" id="access">
            <h5>@L["Access_settings"]</h5>

            @if (Model.Inventory.IsPublic)
            {
                <div class="alert alert-info">
                    <strong>@L["Public_inventory"]</strong> – @L["Accessible_to_all_users"]
                </div>
            }
            else
            {
                <p>@L["Manage_users_with_access"]</p>

                <div class="card mb-3">
                    <div class="card-body">
                        <form asp-action="AddUserAccess" asp-controller="Inventories" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />

                            <div class="mb-2">
                                <label class="form-label">@L["Select_user_to_add"]</label>
                                <select name="userId" class="form-select" required>
                                    <option value="">@L["Choose_user"]...</option>
                                    @foreach (var user in Model.UsersWithoutAccess)
                                    {
                                        <option value="@user.Id">@user.UserName (@user.Email)</option>
                                    }
                                </select>
                            </div>


                            <button type="submit" class="btn btn-primary">@L["Add_user"]</button>
                        </form>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>@L["Users_with_access"]</strong>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.Inventory.Id" asp-route-sortOrder="name"
                           class="btn btn-sm btn-outline-secondary @(Model.SortOrder == "name" ? "active" : "")">
                            @L["Sort_by_name"]
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Inventory.Id" asp-route-sortOrder="email"
                           class="btn btn-sm btn-outline-secondary @(Model.SortOrder == "email" ? "active" : "")">
                            @L["Sort_by_email"]
                        </a>
                         <button id="deleteSelectedBtn" class="btn btn-sm btn-outline-danger ms-2" disabled>
                    <i class="fas fa-trash-alt me-1"></i>@L["Delete_selected"]
                </button>
                    </div>
                </div>
                <form id="bulkDeleteForm" asp-action="RemoveUserAccessMultiple" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="inventoryId" value="@Model.Inventory.Id" />

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr class="text-muted small text-uppercase">
                                    <th style="width: 40px;">
                                        <input type="checkbox" id="selectAllUsers" class="form-check-input" />
                                    </th>
                                    <th>@L["Name"]</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AllowedUsers != null && Model.AllowedUsers.Any())
                                {
                                    foreach (var user in Model.AllowedUsers)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="selectedUserIds" value="@user.Id" class="form-check-input user-checkbox" />
                                            </td>
                                            <td>@user.UserName</td>
                                            <td>@user.Email</td>
                                           
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-muted text-center">@L["No_users_with_access"]</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>

            }
        </div>

        <div class="tab-pane fade" id="elements">
            @await Html.PartialAsync("_InventoriesFields", new CourseWork.Models.InventoryFieldsVM
   {
       Fields = fieldsList,
       FieldForm = new InventoryFieldCreateVM { InventoryId = Model.Inventory.Id }
   })
        </div>
    }
</div>
<style>
    #inventoryTabs .nav-link {
        white-space: nowrap;
        min-width: 90px;
        text-align: center;
    }

    @@media (max-width: 576px) {
        #inventoryTabs

    {
        -webkit-overflow-scrolling: touch; 
    }

    }</style>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl('/discussionHub').build();
        connection.start().then(() => connection.invoke('Join', '@Model.Inventory.Id'));
        connection.on('ReceiveMessage', msg => {
            const html = `<div class="mb-2 p-2 border rounded">
                <strong>${msg.user}</strong>
                <small class="text-muted">${new Date(msg.time).toLocaleString()}</small>
                <div class="mt-1">${renderMarkdown(msg.message)}</div></div>`;
            const container = document.getElementById('messages');
            container.insertAdjacentHTML('beforeend', html);
            container.scrollTop = container.scrollHeight;
        });
        function renderMarkdown(t) {
            return t.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/`(.*?)`/g, '<code>$1</code>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
                    .replace(/\n/g, '<br>');
        }
        document.getElementById('sendMsg')?.addEventListener('click', () => {
            const text = document.getElementById('msgText').value.trim();
            if (text) {
                connection.invoke('SendMessage', '@Model.Inventory.Id', text);
                document.getElementById('msgText').value = '';
            }
        });

        function previewImage(event) {
            const output = document.getElementById('imagePreview');
            output.src = URL.createObjectURL(event.target.files[0]);
            output.classList.remove('d-none');
        }
      


function toggleAll(source) {
    const checkboxes = document.querySelectorAll('input[name="selectedIds"]');
    checkboxes.forEach(cb => cb.checked = source.checked);
}

             document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAllUsers'); 
            const checkboxes = document.querySelectorAll('.user-checkbox');
            const deleteBtn = document.getElementById('deleteSelectedBtn');
            const form = document.getElementById('bulkDeleteForm');

            function updateDeleteButton() {
                const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
                deleteBtn.disabled = !anyChecked;
            }

            selectAll.addEventListener('change', function () {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                updateDeleteButton();
            });

            checkboxes.forEach(cb => cb.addEventListener('change', updateDeleteButton));

            deleteBtn.addEventListener('click', function (e) {
                e.preventDefault();
                if (confirm('@L["Confirm_delete_selected_users"]')) {
                    form.submit();
                }
            });
        });
                   const desc = document.getElementById('inventoryDescription');
            desc.innerHTML = renderMarkdown(desc.textContent);
    </script>
}
