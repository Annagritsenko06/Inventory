@using Microsoft.AspNetCore.Mvc.Localization
@model IEnumerable<CourseWork.Models.Inventories>
@inject IViewLocalizer L

@{
    ViewData["Title"] = "Inventories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark">@L["All_Inventories"]</h2>
    <a asp-controller="Inventories" asp-action="Create" class="btn btn-dark rounded-pill px-4">
        <i class="fas fa-plus me-2"></i>@L["Create_inventory"]
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-muted small text-uppercase">
                            <th>@L["Name"]</th>
                            <th>@L["Category"]</th>
                            <th>@L["Visibility"]</th>
                            <th>@L["Fields"]</th>
                            <th>@L["Tags"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@inv.Id"
                                       class="text-dark fw-semibold text-decoration-none">
                                        @inv.Name
                                    </a>
                                    <div class="text-muted small">
                                        @(inv.Description?.Length > 80 ? inv.Description.Substring(0, 80) + "..." : inv.Description)
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2">
                                        @inv.Category
                                    </span>
                                </td>
                                <td>
                                    @if (inv.IsPublic)
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2">
                                            @(L["Public"])
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2">
                                            @(L["Private"])
                                        </span>
                                    }
                                </td>
                                <td>
                                    <i class="fas fa-list me-1"></i> @(inv.Fields?.Count() ?? 0)
                                </td>
                                <td>
                                    @if (inv.Tags != null && inv.Tags.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var tag in inv.Tags.Take(3))
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1">@tag.Name</span>
                                            }
                                            @if (inv.Tags.Count() > 3)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1">+@(inv.Tags.Count() - 3)</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="fas fa-inbox mb-3" style="font-size: 3rem;"></i>
        <h5>@L["No_inventories_found"]</h5>
        <p>@L["Try_adjusting_search_or_create_new"]</p>
        <a asp-controller="Inventories" asp-action="Create" class="btn btn-outline-dark rounded-pill">
            @L["Create_first_inventory"]
        </a>
    </div>
}
