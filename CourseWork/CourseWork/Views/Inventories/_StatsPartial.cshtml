@model CourseWork.Models.InventoryWithItemsViewModel

<h5>Статистика</h5>

@if (Model.Items == null || !Model.Items.Any())
{
    <p class="text-muted">Нет элементов для анализа.</p>
}
else
{
    <div class="card p-3">
        <h6>Общая статистика</h6>
        <ul>
            <li>Всего элементов: <strong>@Model.Items.Count()</strong></li>
            <li>
                Среднее количество лайков:
                <strong>@(Model.Items.Any() ? Model.Items.Average(i => i.Likes.Count).ToString("0.##") : "0")</strong>
            </li>
            <li>
                Самый популярный элемент:
                <strong>@(Model.Items.OrderByDescending(i => i.Likes.Count).FirstOrDefault()?.CustomId ?? "Нет")</strong>
            </li>
        </ul>

        <hr />
        <h6>Статистика по полям</h6>
        <table class="table table-sm">
            <thead>
                <tr><th>Поле</th><th>Тип</th><th>Заполнено элементов</th></tr>
            </thead>
            <tbody>
                @foreach (var field in Model.Inventory.Fields.OrderBy(f => f.Order))
                {
                    var filledCount = Model.Items.Count(i => 
                    {
                        var values = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(i.ValuesJson);
                        return values.ContainsKey(field.Name) && values[field.Name] != null;
                    });
                    <tr>
                        <td>@field.Name</td>
                        <td>@field.Type</td>
                        <td>@filledCount из @Model.Items.Count()</td>
                    </tr>
                }
            </tbody>
        </table>

        <hr />
        <h6>Топ элементов по лайкам</h6>
        <table class="table table-sm">
            <thead>
                <tr><th>ID</th><th>Создан</th><th>Лайки</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items.OrderByDescending(i => i.Likes.Count).Take(10))
                {
                    <tr>
                        <td>@item.CustomId</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>@item.Likes.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
