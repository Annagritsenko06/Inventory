@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model CourseWork.Models.Inventories

<div class="container mt-3">
    <h3 class="mb-3">@L["InventorySettings"]</h3>

    <form asp-action="SaveSettings" asp-controller="Inventories" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <!-- Название -->
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">@L["Name"]</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <!-- Категория -->
            <div class="col-md-6">
                <label asp-for="Category" class="form-label">@L["Category"]</label>
                <select asp-for="Category" class="form-select">
                    <option>@L["Equipment"]</option>
                    <option>@L["Furniture"]</option>
                    <option>@L["Book"]</option>
                    <option>@L["Other"]</option>
                </select>
            </div>

            <!-- Описание (Markdown) -->
            <div class="col-12">
                <label asp-for="Description" class="form-label">@L["DescriptionMarkdown"]</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="@L["DescriptionPlaceholder"]"></textarea>
                <small class="text-muted">@L["MarkdownHint"]</small>
            </div>

            <!-- Изображение -->
            <div class="col-md-6">
                <label asp-for="ImageUrl" class="form-label">@L["ImageUrl"]</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.ImageUrl" alt="@L["InventoryImageAlt"]" class="img-thumbnail" style="max-height:150px;" />
                    </div>
                }
            </div>

            <!-- Публичность -->
            <div class="col-md-6 form-check mt-4">
                <input asp-for="IsPublic" class="form-check-input" />
                <label asp-for="IsPublic" class="form-check-label">@L["PublicInventory"]</label>
                <div class="form-text">@L["PublicInventoryHint"]</div>
            </div>

            <!-- Теги -->
            <div class="col-12 position-relative">
                <label class="form-label">Теги</label>
                <input id="tagInput" class="form-control" placeholder="Введите тег..." />
                <div id="tagSuggestions" class="list-group position-absolute w-100" style="z-index:1000;"></div>
                <div id="selectedTags" class="mt-2 d-flex flex-wrap gap-1">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-light text-dark border px-2 py-1">@tag.Name</span>
                    }
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <!-- Конструктор пользовательского ID -->
        <h4>@L["CustomIdTitle"]</h4>
        <p class="text-muted">
            @L["CustomIdDescription"]
            <span class="text-info" data-bs-toggle="popover" data-bs-trigger="hover" title="@L["Help"]"
                  data-bs-content="@L["HelpContent"]">
                ?
            </span>
        </p>

        <div id="idFormatBuilder" class="d-flex flex-wrap gap-2 border p-3 rounded bg-light">
            <!-- части ID -->
        </div>

        <div class="dropdown mt-2">
            <button class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">@L["AddElement"]</button>
            <ul class="dropdown-menu">
                <li><button class="dropdown-item" type="button" onclick="addPart('FixedText')">@L["FixedText"]</button></li>
                <li><button class="dropdown-item" type="button" onclick="addPart('Random6')">@L["Random6"]</button></li>
                <li><button class="dropdown-item" type="button" onclick="addPart('Random9')">@L["Random9"]</button></li>
                <li><button class="dropdown-item" type="button" onclick="addPart('Guid')">@L["Guid"]</button></li>
                <li><button class="dropdown-item" type="button" onclick="addPart('DateTime')">@L["DateTime"]</button></li>
                <li><button class="dropdown-item" type="button" onclick="addPart('Sequence')">@L["Sequence"]</button></li>
            </ul>
        </div>

        <input type="hidden" id="customIdFormatJson" name="CustomIdFormatJson" value="@Model.CustomIdFormatJson" />

        <div class="mt-4">
            <button type="submit" class="btn btn-success">@L["SaveSettings"]</button>
        </div>
    </form>
</div>


@section Scripts {
    <script>
       

        // ----------------------------
        //  Конструктор ID
        // ----------------------------
        let parts = [];

        // если есть сохранённый JSON, загружаем
        try {
            const saved = document.getElementById('customIdFormatJson').value;
            if (saved) parts = JSON.parse(saved);
        } catch { parts = []; }

        function addPart(type) {
            const part = { type, value: '', order: parts.length };
            parts.push(part);
            renderParts();
            updateHiddenInput();
        }

        function removePart(index) {
            parts.splice(index, 1);
            renderParts();
            updateHiddenInput();
        }

        function renderParts() {
            const container = document.getElementById('idFormatBuilder');
            container.innerHTML = '';
            parts.forEach((p, i) => {
                const div = document.createElement('div');
                div.className = 'bg-white border rounded p-2 d-flex align-items-center gap-2';
                div.draggable = true;
                div.ondragstart = e => e.dataTransfer.setData('index', i);
                div.ondrop = e => swapParts(i, e);
                div.ondragover = e => e.preventDefault();

                div.innerHTML = `
                    <span class="fw-bold">${p.type}</span>
                    ${p.type === 'FixedText' ? `<input class='form-control form-control-sm' value='${p.value || ""}'
                        placeholder='текст...' onchange='parts[${i}].value=this.value;updateHiddenInput();' />` : ''}
                    <button class='btn btn-sm btn-outline-danger' onclick='removePart(${i})'>✕</button>
                `;
                container.appendChild(div);
            });
        }

        function swapParts(targetIndex, e) {
            e.preventDefault();
            const sourceIndex = e.dataTransfer.getData('index');
            if (sourceIndex == targetIndex) return;
            const moved = parts.splice(sourceIndex, 1)[0];
            parts.splice(targetIndex, 0, moved);
            renderParts();
            updateHiddenInput();
        }

        function updateHiddenInput() {
            document.getElementById('customIdFormatJson').value = JSON.stringify(parts);
        }

        renderParts();

        // Bootstrap popovers
        document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => new bootstrap.Popover(el));
    </script>
}
