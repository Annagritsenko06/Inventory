@model CourseWork.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container vh-100">
    <div class="row h-100 align-items-center">
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <div class="mb-4">
                <h2>Welcome back</h2>
                <p>Sign in to your account</p>
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">@TempData["Message"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <form asp-action="Login" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign In</button>
                <hr />
                <h4 class="mb-3">Войти через:</h4>

                <div class="row g-2 text-center">
                    <div class="col-6">
                        <form asp-controller="Registration" asp-action="ExternalLogin" method="post">
                            <input type="hidden" name="provider" value="Google" />
                            <button type="submit" class="btn btn-danger w-100 py-2">
                                <i class="bi bi-google me-2"></i> Google
                            </button>
                        </form>
                    </div>
                    <div class="col-6">
                        <form asp-controller="Registration" asp-action="ExternalLogin" method="post">
                            <input type="hidden" name="provider" value="Facebook" />
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="bi bi-facebook me-2"></i> Facebook
                            </button>
                        </form>
                    </div>
                </div>



                <div class="mt-3 text-center">
                    Don't have an account? <a asp-action="Register">Sign up</a>
                </div>
            </form>
        </div>

        <div class="col-lg-6 d-none d-lg-block">
            <img src="~/main.jpg" class="img-fluid w-100" style="height: 100%; max-height: 85vh; object-fit: cover; border-radius: 0.5rem;" alt="Registration Background" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
