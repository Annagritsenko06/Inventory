@model IEnumerable<CourseWork.Models.Inventories>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">Нет доступных инвентарей.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col" class="sortable" onclick="sortTable(this, 0)">Название ↑↓</th>
                <th scope="col" class="sortable" onclick="sortTable(this, 1)">Описание ↑↓</th>
                <th scope="col" class="sortable" onclick="sortTable(this, 2)">Категория ↑↓</th>
                <th scope="col">Публичный</th>
                <th scope="col" class="text-center">Действия</th>
            </tr>
        </thead>
        <tbody id="inventoriesTableBody">
            @foreach (var inv in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inv.Id"
                           class="fw-bold text-decoration-none">
                            @inv.Name
                        </a>
                    </td>
                    <td>@inv.Description</td>
                    <td>@inv.Category</td>
                    <td>
                        @if (inv.IsPublic)
                        {
                            <span class="badge bg-success">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Нет</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-toolbar justify-content-center" role="toolbar">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary dropdown-toggle"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    ⚙️
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Inventories"
                                           asp-action="Details"
                                           asp-route-id="@inv.Id">
                                            Открыть
                                        </a>
                                    </li>

                                    @* Только владелец или администратор может редактировать/удалять *@
                                    @if (User.Identity.IsAuthenticated &&
                                   (User.IsInRole("Admin") ||
                                   User.FindFirst("sub")?.Value == inv.OwnerId.ToString() ||
                                   User.Identity.Name == inv.OwnerId.ToString()))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Inventories"
                                               asp-action="Edit"
                                               asp-route-inventoryId="@inv.Id">
                                                Редактировать
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger"
                                               asp-controller="Inventories"
                                               asp-action="Delete"
                                               asp-route-id="@inv.Id">
                                                Удалить
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        function sortTable(header, columnIndex) {
            const table = header.closest('table');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            const ascending = !header.classList.contains('asc');

            rows.sort((a, b) => {
                const cellA = a.children[columnIndex].innerText.trim().toLowerCase();
                const cellB = b.children[columnIndex].innerText.trim().toLowerCase();
                return ascending ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
            });

            tbody.innerHTML = '';
            rows.forEach(r => tbody.appendChild(r));

            table.querySelectorAll('th').forEach(th => th.classList.remove('asc', 'desc'));
            header.classList.add(ascending ? 'asc' : 'desc');
        }
    </script>
}
