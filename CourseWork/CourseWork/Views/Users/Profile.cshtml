@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model CourseWork.Models.UserProfile

<div class="container mt-4">
    <h2 class="fw-bold mb-4">👤 @L["MyProfile"]</h2>

    <!-- Вкладки -->
    <ul class="nav nav-tabs" id="inventoryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="owned-tab" data-bs-toggle="tab" data-bs-target="#owned" type="button" role="tab">
                📦 @L["MyInventories"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="writable-tab" data-bs-toggle="tab" data-bs-target="#writable" type="button" role="tab">
                ✏️ @L["WritableInventories"]
            </button>
        </li>
    </ul>

    <div class="tab-content mt-3">
        <!-- Вкладка "Мои инвентари" -->
        <div class="tab-pane fade show active" id="owned" role="tabpanel">
            <div class="mb-3">
                <input id="searchOwned" placeholder="🔍 @L["Filter_by_inventory_name"]" class="form-control" />
            </div>

            <div id="ownedContainer" class="shadow-sm rounded p-2">
                @await Html.PartialAsync("_TemplatesTable", Model.OwnedTemplates)
            </div>
        </div>

        <!-- Вкладка "Инвентари с правом записи" -->
        <div class="tab-pane fade" id="writable" role="tabpanel">
            <div class="mb-3">
                <input id="searchWritable" placeholder="🔍 @L["Filter_by_inventory_name"]" class="form-control" />
            </div>
            <div id="writableContainer" class="shadow-sm rounded p-2">
                @await Html.PartialAsync("_TemplatesTable", Model.WritableTemplates)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Фильтрация вкладки "Мои инвентари"
        document.getElementById("searchOwned").addEventListener("input", function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll("#ownedContainer tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
            });
        });

        // Фильтрация вкладки "Инвентари с правом записи"
        document.getElementById("searchWritable").addEventListener("input", function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll("#writableContainer tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
            });
        });
    </script>
}

