@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model CourseWork.Models.UserProfile
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">👤 @L["MyProfile"]</h2>

    <ul class="nav nav-tabs" id="inventoryTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="owned-tab" data-bs-toggle="tab" data-bs-target="#owned" type="button" role="tab">
                📦 @L["MyInventories"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="writable-tab" data-bs-toggle="tab" data-bs-target="#writable" type="button" role="tab">
                ✏️ @L["WritableInventories"]
            </button>
        </li>
    </ul>
    <button type="button" class="btn btn-primary mt-4" data-bs-toggle="modal" data-bs-target="#contactModal">
        Создать контакт Salesforce
    </button>
    <div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Salesforce" asp-action="SyncUser" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="contactModalLabel">Создать контакт Salesforce</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Contact fields -->
                        <label>Имя:</label>
                        <input type="text" name="FirstName" class="form-control" required />

                        <label>Фамилия:</label>
                        <input type="text" name="LastName" class="form-control" required />

                        <label>Email:</label>
                        <input type="email" name="Email" class="form-control" required />

                        <label>Телефон:</label>
                        <input type="text" name="Phone" class="form-control" required />

                        <!-- Account fields -->
                        <label>Компания (Account Name):</label>
                        <input type="text" name="CompanyName" class="form-control" required />

                        <label>Адрес (BillingStreet):</label>
                        <input type="text" name="Address" class="form-control" />

                        <label>Рейтинг (Rating):</label>
                        <input type="text" name="Rating" class="form-control" />

                        <label>Номер аккаунта (AccountNumber):</label>
                        <input type="text" name="AccountNumber" class="form-control" />

                        <label>Веб-сайт (Website):</label>
                        <input type="url" name="Website" class="form-control" />

                        <label>Отрасль (Industry):</label>
                        <input type="text" name="Industry" class="form-control" />

                        <label>Сотрудники (Employees):</label>
                        <input type="number" name="Employees" class="form-control" />

                        <label>Годовой доход (AnnualRevenue):</label>
                        <input type="number" step="0.01" name="AnnualRevenue" class="form-control" />


                        <!-- Остальные ваши поля для Contact -->
                        <label>Должность:</label>
                        <input type="text" name="Title" class="form-control" />

                        <label>Отдел:</label>
                        <input type="text" name="Department" class="form-control" />

                        <label>Дата рождения:</label>
                        <input type="date" name="Birthdate" class="form-control" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отменить</button>
                        <button type="submit" class="btn btn-primary">Синхронизировать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>



    <div class="tab-content mt-3">
        <div class="tab-pane fade show active" id="owned" role="tabpanel">
            <div class="mb-3">
                <input id="searchOwned" placeholder="🔍 @L["Filter_by_inventory_name"]" class="form-control" />
            </div>

            <div id="ownedContainer" class="shadow-sm rounded p-2">
                @await Html.PartialAsync("_TemplatesTable", Model.OwnedTemplates)
            </div>
        </div>

        <div class="tab-pane fade" id="writable" role="tabpanel">
            <div class="mb-3">
                <input id="searchWritable" placeholder="🔍 @L["Filter_by_inventory_name"]" class="form-control" />
            </div>
            

            <div id="writableContainer" class="shadow-sm rounded p-2">
                @await Html.PartialAsync("_TemplatesTable", Model.WritableTemplates)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("searchOwned").addEventListener("input", function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll("#ownedContainer tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
            });
        });

        document.getElementById("searchWritable").addEventListener("input", function() {
            const filter = this.value.toLowerCase();
            document.querySelectorAll("#writableContainer tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
            });
        });
    </script>
}

