@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Identity
@using CourseWork.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject IViewLocalizer L

@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - InventoryManager</title>
    <link id="themeStylesheet" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

   
    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/easymde@2.15.0/dist/easymde.min.css" rel="stylesheet" />

    @RenderSection("Head", required: false)
</head>
<body data-bs-theme="@(Context.Request.Cookies["theme"] ?? "light")">

    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">InventoryManager</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <form class="d-flex ms-auto me-3" method="get" asp-controller="Search1" asp-action="Index">
                    <input class="form-control me-2" style="width: 500px; max-width: 100%;" type="search" name="q" placeholder="@L["Search"]" aria-label="Search" value="@ViewData["SearchQuery"]" />
                    <button class="btn btn-outline-primary" type="submit">@L["Search"]</button>
                </form>

                <ul class="navbar-nav">
                   

                    @if (SignInManager.IsSignedIn(User))
                    {
                       
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Profile" sp-route-id="@userId">@User.Identity?.Name</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Index">
                                    @L["Users"]
                                </a>
                            </li>

                        }

                        <li class="nav-item">
                            <form method="post" asp-controller="Registration" asp-action="Logout">
                                <button type="submit" class="btn btn-link nav-link">@L["Logout"]</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Registration" asp-action="Login">@L["Login"]</a></li>
                    }
                   
                  

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-cog me-2"></i>@L["Settings"]
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@L["Language"]</h6></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="en-US" asp-route-returnUrl="@Context.Request.Path">@L["English"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="ru-RU" asp-route-returnUrl="@Context.Request.Path">@L["Russian"]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h6 class="dropdown-header">@L["Theme"]</h6></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="SetTheme" asp-route-theme="light" asp-route-returnUrl="@Context.Request.Path">@L["Light"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="SetTheme" asp-route-theme="dark" asp-route-returnUrl="@Context.Request.Path">@L["Dark"]</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container app-container mt-4 mb-5">
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-info">@TempData["StatusMessage"]</div>
        }

        @RenderBody()
    </div>
    <script>
        const themeLink = document.getElementById('themeStylesheet');

        const themeCookie = document.cookie.split('; ').find(row => row.startsWith('theme='));
        if (themeCookie) {
            themeLink.href = decodeURIComponent(themeCookie.split('=')[1]);
        }
    </script>
    <style>
        .navbar-nav {
            gap: 2rem;
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/easymde@2.15.0/dist/easymde.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    @RenderSection("Styles", required: false)
    @RenderSection("Scripts", required: false)
</body>
</html>
